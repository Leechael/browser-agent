# Source of truth for release naming used by docs/scripts/workflows.

CLI_NAME=browse
BINARY_NAME=browse
TAG_PREFIX=v
ARTIFACT_GLOB=browse-*.tar.gz
BUILD_TARGET=./cmd/browse

# Full package path to the Version variable for ldflags embedding
VERSION_VAR_PATH=github.com/leechael/browser-agent/browse-cli/internal/cmd.Version
